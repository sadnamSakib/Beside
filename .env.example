# Environment
NODE_ENV=development

# Server
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/beside

# JWT
JWT_SECRET=your_jwt_secret_should_be_at_least_32_characters_long
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRES_IN=1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=debug

# Email Configuration
# For development, you can use Mailtrap, Ethereal, or other test SMTP services
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@besideapp.com

# Frontend URL (for email verification and password reset links)
FRONTEND_URL=http://localhost:3000

# SendGrid Configuration (for production)
# SENDGRID_USERNAME=apikey
# SENDGRID_PASSWORD=your_sendgrid_api_key