{
  "name": "beside-api",
  "version": "1.0.0",
  "description": "Beside API backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --exec node src/server.js",
